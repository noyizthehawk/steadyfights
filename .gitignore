# SQLite database files (user data + password hashes — never commit)
*.db
web/backend/app.db
.venv/

# Python
__pycache__/
*.pyc

# Node / frontend
# unanchored, so it catches the ROOT node_modules too — that one was tracked
# (681 files), so every npm install churned the diff
node_modules/
# dist/ IS committed on purpose: Railway serves it via FastAPI and doesn't run
# npm. Rule: rebuild (npm run build) before pushing frontend changes.

# IDE
.idea/

# curl cookie jar the scraper writes — an artifact, and would commit a live
# session if one were ever captured
cookies.txt

# Env / secrets
.env

# Claude Code local config + skills (machine-local, not project source)
.claude/

# cron job logs
logs/
